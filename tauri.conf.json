{
  "build": {
    "beforeBuildCommand": "npm run type-check",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "frontendDist": "../frontend/dist",
    "files": [
      "../frontend/dist/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Antigravity Workspace",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true
      },
      "fs": {
        "all": true,
        "scope": ["$DOCUMENT/**", "$DOWNLOAD/**"]
      }
    },
    "security": {
      "csp": null
    }
  }
}
